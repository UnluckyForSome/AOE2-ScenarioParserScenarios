# Path to your local AoE2:DE scenario folder (do NOT commit your real .env)
# Example:
# AOE2_SCENARIO_DIRECTORY=C:/Users/<you>/Games/Age of Empires 2 DE/76561198202630125/resources/_common/scenario
AOE2_SCENARIO_DIRECTORY=

# Optional: starting scenario file name inside AOE2_SCENARIO_DIRECTORY
AOE2_STARTING_SCENARIO_FILENAME=e3-p2-default.aoe2scenario